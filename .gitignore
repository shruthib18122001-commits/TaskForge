# Measured artifacts: keep the directory layout, ignore generated data.
# Committed sample files (results/csv/sample_*.csv) are force-added and stay tracked.
/results/csv/*.csv
!/results/csv/sample_*.csv
/results/perf/*
!/results/perf/.gitkeep
/results/charts/*
!/results/charts/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
